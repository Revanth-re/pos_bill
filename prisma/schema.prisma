generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// A registered login. One User can belong to (own or work at) one Business
/// via a Staff record. Kept separate from Staff so Auth.js can own this table.
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

/// The tenant. Every business-scoped model hangs off businessId so this app
/// could serve multiple businesses per deployment without cross-tenant leaks.
model Business {
  id             String   @id @default(cuid())
  name           String
  legalName      String?
  phone          String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  gstin          String?
  gstEnabled     Boolean  @default(true)
  taxInclusive   Boolean  @default(true)
  cgstPercent    Decimal  @default(2.5) @db.Decimal(5, 2)
  sgstPercent    Decimal  @default(2.5) @db.Decimal(5, 2)
  igstPercent    Decimal  @default(5) @db.Decimal(5, 2)
  currency       String   @default("INR")
  timezone       String   @default("Asia/Kolkata")
  language       String   @default("en")
  invoicePrefix  String   @default("INV")
  invoiceCounter Int      @default(0)
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("businesses")
}

/// Links a User to a Business with a role. A user could staff multiple
/// businesses in theory; role/permissions are always evaluated per-Staff row.
model Staff {
  id         String      @id @default(cuid())
  businessId String
  userId     String
  role       StaffRole
  status     StaffStatus @default(ACTIVE)
  pin        String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([businessId, userId])
  @@map("staff")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, name])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  businessId     String
  categoryId     String?
  name           String
  alias          String?
  sku            String?
  barcode        String?
  unit           String        @default("pc")
  purchasePrice  Decimal       @default(0) @db.Decimal(10, 2)
  sellingPrice   Decimal       @db.Decimal(10, 2)
  mrp            Decimal?      @db.Decimal(10, 2)
  gstPercent     Decimal       @default(5) @db.Decimal(5, 2)
  trackInventory Boolean       @default(true)
  currentStock   Decimal       @default(0) @db.Decimal(10, 3)
  minStock       Decimal       @default(0) @db.Decimal(10, 3)
  status         ProductStatus @default(ACTIVE)
  imageUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId, name])
  @@index([businessId, barcode])
  @@index([businessId, sku])
  @@map("products")
}

/// Raw ingredient used in recipes. Distinct from Product because ingredients
/// are purchased in bulk units (kg/L) and are not sold directly.
model Ingredient {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  unit         String
  purchaseCost Decimal  @db.Decimal(10, 2)
  currentStock Decimal  @default(0) @db.Decimal(10, 3)
  minStock     Decimal  @default(0) @db.Decimal(10, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, name])
  @@map("ingredients")
}

/// One-to-one with Product. If a Product has a Recipe, food cost & margin
/// are computed from its RecipeIngredient lines instead of purchasePrice.
model Recipe {
  id        String   @id @default(cuid())
  productId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recipes")
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(10, 3)

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

/// Append-only ledger. currentStock on Product/Ingredient is a cached
/// aggregate; this table is the source of truth / audit trail.
model InventoryMovement {
  id           String                @id @default(cuid())
  businessId   String
  productId    String?
  ingredientId String?
  type         InventoryMovementType
  quantity     Decimal               @db.Decimal(10, 3)
  reason       String?
  reference    String?
  staffId      String?
  createdAt    DateTime              @default(now())

  @@index([businessId, productId])
  @@index([businessId, ingredientId])
  @@map("inventory_movements")
}

model Customer {
  id                 String   @id @default(cuid())
  businessId         String
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  outstandingBalance Decimal  @default(0) @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([businessId, phone])
  @@map("customers")
}

model CustomerLedger {
  id           String          @id @default(cuid())
  businessId   String
  customerId   String
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(10, 2)
  balanceAfter Decimal         @db.Decimal(10, 2)
  invoiceId    String?
  note         String?
  createdAt    DateTime        @default(now())

  @@index([businessId, customerId])
  @@map("customer_ledger")
}

model Order {
  id                String        @id @default(cuid())
  businessId        String
  staffId           String
  customerId        String?
  type              OrderType     @default(TAKEAWAY)
  status            OrderStatus   @default(HELD)
  billDiscountType  DiscountType?
  billDiscountValue Decimal?      @db.Decimal(10, 2)
  label             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([businessId, status])
  @@map("orders")
}

model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  productId     String
  quantity      Decimal       @db.Decimal(10, 3)
  unitPrice     Decimal       @db.Decimal(10, 2)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(10, 2)

  @@map("order_items")
}

/// Created only when an Order is completed (never for held orders).
/// All monetary totals here are server-computed and authoritative.
model Invoice {
  id            String        @id @default(cuid())
  businessId    String
  invoiceNumber String
  orderId       String        @unique
  staffId       String
  subtotal      Decimal       @db.Decimal(10, 2)
  discountTotal Decimal       @default(0) @db.Decimal(10, 2)
  cgstTotal     Decimal       @default(0) @db.Decimal(10, 2)
  sgstTotal     Decimal       @default(0) @db.Decimal(10, 2)
  igstTotal     Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(PAID)
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String
  productName String
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  gstPercent  Decimal @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal @db.Decimal(10, 2)

  @@map("invoice_items")
}

/// One Invoice can have multiple Payment rows to support split payments
/// (e.g. Cash 300 + UPI 550).
model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  staffId   String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@map("payments")
}

/// Bills parked mid-order ("customer waiting") — kept out of the Order model
/// so a held bill never accidentally deducts inventory or counts as a sale.
model HeldBill {
  id         String   @id @default(cuid())
  businessId String
  staffId    String
  label      String?
  cartJson   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("held_bills")
}

model ExpenseCategory {
  id         String  @id @default(cuid())
  businessId String
  name       String
  isDefault  Boolean @default(false)

  @@map("expense_categories")
}

model Expense {
  id            String        @id @default(cuid())
  businessId    String
  categoryId    String
  amount        Decimal       @db.Decimal(10, 2)
  date          DateTime      @default(now())
  description   String?
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())

  @@map("expenses")
}

model TiffinPlan {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  price        Decimal  @db.Decimal(10, 2)
  totalMeals   Int
  durationDays Int
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("tiffin_plans")
}

model TiffinSubscription {
  id           String                   @id @default(cuid())
  businessId   String
  planId       String
  customerId   String
  startDate    DateTime                 @default(now())
  endDate      DateTime
  totalMeals   Int
  mealsUsed    Int                      @default(0)
  mealsSkipped Int                      @default(0)
  extraMeals   Int                      @default(0)
  amountPaid   Decimal                  @default(0) @db.Decimal(10, 2)
  status       TiffinSubscriptionStatus @default(ACTIVE)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@map("tiffin_subscriptions")
}

model TiffinMealUsage {
  id             String          @id @default(cuid())
  subscriptionId String
  type           TiffinUsageType
  date           DateTime        @default(now())
  reason         String?
  extraCharge    Decimal?        @db.Decimal(10, 2)
  createdAt      DateTime        @default(now())

  @@map("tiffin_meal_usage")
}

model DayClosing {
  id              String   @id @default(cuid())
  businessId      String
  date            DateTime @db.Date
  totalSales      Decimal  @db.Decimal(10, 2)
  cashSales       Decimal  @db.Decimal(10, 2)
  upiSales        Decimal  @db.Decimal(10, 2)
  cardSales       Decimal  @db.Decimal(10, 2)
  creditSales     Decimal  @db.Decimal(10, 2)
  expensesTotal   Decimal  @db.Decimal(10, 2)
  refundsTotal    Decimal  @default(0) @db.Decimal(10, 2)
  discountsTotal  Decimal  @default(0) @db.Decimal(10, 2)
  openingCash     Decimal  @db.Decimal(10, 2)
  expectedCash    Decimal  @db.Decimal(10, 2)
  actualCash      Decimal  @db.Decimal(10, 2)
  cashDifference  Decimal  @db.Decimal(10, 2)
  closedByStaffId String
  closedAt        DateTime @default(now())
  locked          Boolean  @default(true)

  @@map("day_closings")
}

model Printer {
  id                  String      @id @default(cuid())
  businessId          String
  name                String
  type                PrinterType
  isDefault           Boolean     @default(false)
  config              Json?
  bluetoothDeviceId   String?
  bluetoothDeviceName String?
  createdAt           DateTime    @default(now())

  @@map("printers")
}

model Notification {
  id          String           @id @default(cuid())
  businessId  String
  type        NotificationType
  title       String
  message     String
  actionLabel String?
  actionUrl   String?
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  staffId    String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

/// Server-side record of an offline-created bill once it reaches the server.
/// The client id (generated in IndexedDB) is kept for idempotent dedupe.
model OfflineTransaction {
  id         String     @id @default(cuid())
  businessId String
  clientId   String
  payload    Json
  status     SyncStatus @default(PENDING)
  invoiceId  String?
  error      String?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())
  syncedAt   DateTime?

  // Used by offline sync to safely deduplicate/retry the same client transaction.
  @@unique([clientId])
  @@map("offline_transactions")
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryMovementType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  DAMAGE
  RECIPE_DEDUCTION
}

enum LedgerEntryType {
  CREDIT_SALE
  PAYMENT
  ADJUSTMENT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  HELD
  COMPLETED
  CANCELLED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
}

enum TiffinSubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TiffinUsageType {
  USED
  SKIPPED
  EXTRA
}

enum PrinterType {
  THERMAL_58MM
  THERMAL_80MM
  A4
  BROWSER
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  HIGH_DISCOUNT
  LARGE_REFUND
  SALES_DROP
  EXPENSE_INCREASE
  HIGH_FOOD_COST
  PENDING_CREDIT
  TIFFIN_EXPIRY
  INFO
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
}
